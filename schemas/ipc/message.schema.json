{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visionaiflow/ipc/message.schema.json",
  "title": "VisionAIFlow local IPC message",
  "type": "object",
  "required": ["protocolVersion", "requestId", "jobId", "type", "timestampUtc"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "jobId": { "type": "string" },
    "type": { "type": "string", "minLength": 1 },
    "timestampUtc": { "type": "string", "format": "date-time" },
    "errorCode": { "type": "string", "minLength": 1 },
    "errorMessage": { "type": "string", "minLength": 1 },
    "recoverable": { "type": "boolean" },
    "details": { "type": "object" },
    "hostRole": { "type": "string", "minLength": 1 },
    "runtimeVersion": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "error" } } },
      "then": { "required": ["errorCode", "errorMessage", "recoverable"] }
    }
  ],
  "additionalProperties": true
}
